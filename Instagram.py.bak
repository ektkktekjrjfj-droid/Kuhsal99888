# --- SPEED HELPERS ---
def get_clean_otp(text):
    matches = re.findall(r'\b\d{4,8}\b', text)
    return matches[0] if matches else "NOT FOUND"

def detect_platform(text):
    text = text.lower()
    if "instagram" in text: return "Instagram", "https://instagram.com"
    if "facebook" in text: return "Facebook", "https://facebook.com"
    return "Web Service", "https://google.com"

# --- FAST ENGINE ---
def check_inbox(uid, email, token, last_id):
    try:
        headers = {"Authorization": f"Bearer {token}"}
        r = requests.get("https://api.mail.tm/messages", headers=headers, timeout=5).json()
        msgs = r.get('hydra:member', [])
        
        if msgs:
            m = msgs[0]
            m_id = str(m['id'])
            if m_id != str(last_id):
                detail = requests.get(f"https://api.mail.tm/messages/{m_id}", headers=headers).json()
                body = detail.get('intro', '')
                subj = detail.get('subject', '')
                otp = get_clean_otp(body + subj)
                plat_name, plat_url = detect_platform(body + subj)

                ui = (
                    f"📧 <b>Account:</b> <code>{email}</code>\n"
                    f"📝 <b>Subject:</b> <i>{subj}</i>\n"
                    f"🔗 <b>Platform:</b> <a href='{plat_url}'>{plat_name}</a>\n"
                    f"━━━━━━━━━━━━━━━━━━\n"
                    f"⚡ <b>OTP CODE:</b> <code>{otp}</code>\n"
                    f"━━━━━━━━━━━━━━━━━━\n"
                    f"🔹 <i>Tap code to copy instantly</i>"
                )
                bot.send_message(uid, ui, disable_web_page_preview=True)
                if users_col is not None:
                    users_col.update_one({"uid": uid}, {"$set": {"last_id": m_id}})
    except: pass

def background_loop():
    while True:
        try:
            if users_col is not None:
                all_users = list(users_col.find({"token": {"$exists": True}}))
                with ThreadPoolExecutor(max_workers=30) as exe:
                    for user in all_users:
                        exe.submit(check_inbox, user['uid'], user['email'], user['token'], user.get('last_id', '0'))
        except: pass
        time.sleep(1.5)

# --- MENU & START ---
def set_menu():
    bot.set_my_commands([
        telebot.types.BotCommand("start", "🏠 Home"),
        telebot.types.BotCommand("generate", "📧 Get Mail"),
        telebot.types.BotCommand("id", "📊 My History"),
        telebot.types.BotCommand("reset", "🗑️ Clear Data")
    ])

@bot.message_handler(commands=['start'])
def welcome(m):
    set_menu()
    bot.reply_to(m, "🚀 <b>Kushal Premium Store LIVE!</b>\n\nUse /generate to get an email.")

@bot.message_handler(commands=['generate'])
def gen(m):
    uid = m.chat.id
    try:
        doms = requests.get("https://api.mail.tm/domains").json()['hydra:member']
        email = f"kushal{random.randint(100,999)}@{doms[0]['domain']}"
        pwd = "password123"
        requests.post("https://api.mail.tm/accounts", json={"address": email, "password": pwd})
        tk = requests.post("https://api.mail.tm/token", json={"address": email, "password": pwd}).json()
        token = tk.get('token')

        if token and users_col is not None:
            users_col.update_one({"uid": uid}, {"$set": {"email": email, "token": token, "last_id": "0"}}, upsert=True)
            history_col.insert_one({"uid": uid, "email": email, "id_code": str(random.randint(1000, 9999))})
            bot.send_message(uid, f"✅ <b>Email:</b> <code>{email}</code>")
    except: bot.send_message(uid, "❌ Server Busy")

if __name__ == "__main__":
    # 1. Run Flask Server in background for Render's health check
    threading.Thread(target=run_flask_server, daemon=True).start()
    
    # 2. Start Bot and Background Loops
    set_menu()
    threading.Thread(target=background_loop, daemon=True).start()
    print(">>> Bot is LIVE")
    bot.polling(none_stop=True)
