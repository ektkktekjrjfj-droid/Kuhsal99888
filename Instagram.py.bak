# --- KEYBOARDS ---
def main_menu():
    markup = types.InlineKeyboardMarkup(row_width=2)
    markup.add(
        types.InlineKeyboardButton("📧 Generate Mail", callback_data="gen_mail"),
        types.InlineKeyboardButton("📊 My History", callback_data="show_id"),
        types.InlineKeyboardButton("🗑️ Clear History", callback_data="clear_all"),
        types.InlineKeyboardButton("📢 Support", url="https://t.me/KUSHALPREMIUMSTORE")
    )
    return markup

# --- ENGINE ---
def get_clean_otp(text):
    matches = re.findall(r'\b\d{4,8}\b', text)
    return matches[0] if matches else "NOT FOUND"

def check_inbox(uid, email, token, last_id):
    try:
        headers = {"Authorization": f"Bearer {token}"}
        r = requests.get("https://api.mail.tm/messages", headers=headers, timeout=5).json()
        msgs = r.get('hydra:member', [])
        if msgs:
            m = msgs[0]
            if str(m['id']) != str(last_id):
                detail = requests.get(f"https://api.mail.tm/messages/{m['id']}", headers=headers).json()
                otp = get_clean_otp(detail.get('intro', '') + detail.get('subject', ''))
                
                ui = (
                    f"✨ <b>NEW MESSAGE RECEIVED</b> ✨\n"
                    f"━━━━━━━━━━━━━━━━━━\n"
                    f"📧 <b>Mail:</b> <code>{email}</code>\n"
                    f"📝 <b>Subject:</b> <i>{detail.get('subject')}</i>\n"
                    f"━━━━━━━━━━━━━━━━━━\n"
                    f"⚡ <b>OTP CODE:</b> <code>{otp}</code>\n"
                    f"━━━━━━━━━━━━━━━━━━\n"
                    f"🔹 <i>Kushal Premium Service</i>"
                )
                bot.send_message(uid, ui)
                users_col.update_one({"uid": uid}, {"$set": {"last_id": m['id']}})
    except: pass

def background_loop():
    while True:
        try:
            all_users = list(users_col.find({"token": {"$exists": True}}))
            with ThreadPoolExecutor(max_workers=50) as exe:
                for user in all_users:
                    exe.submit(check_inbox, user['uid'], user['email'], user['token'], user.get('last_id', '0'))
        except: pass
        time.sleep(1)

# --- START COMMAND (WITH PHOTO & MENTION) ---
@bot.message_handler(commands=['start'])
def welcome(m):
    uid = m.chat.id
    first_name = m.from_user.first_name
    username = f"@{m.from_user.username}" if m.from_user.username else "No Username"
    
    # User mention highlight
    user_mention = f"<a href='tg://user?id={uid}'>{first_name}</a>"
    
    # Save user to DB
    users_col.update_one({"uid": uid}, {"$set": {"name": first_name, "username": username}}, upsert=True)

    welcome_text = (
        f"🌟 <b>Welcome to KUSHAL PREMIUM STORE</b> 🌟\n\n"
        f"👤 <b>User:</b> {user_mention}\n"
        f"🆔 <b>ID:</b> <code>{uid}</code>\n"
        f"🛠️ <b>Status:</b> <code>Premium Active</code>\n\n"
        f"<i>Bhai, yahan aapko ultra-fast temporary emails milenge. Niche diye gaye buttons use karein!</i>"
    )

    try:
        # Get user profile photo
        photos = bot.get_user_profile_photos(uid)
        if photos.total_count > 0:
            bot.send_photo(uid, photos.photos[0][-1].file_id, caption=welcome_text, reply_markup=main_menu())
        else:
            bot.send_message(uid, welcome_text, reply_markup=main_menu())
    except:
        bot.send_message(uid, welcome_text, reply_markup=main_menu())

# --- CALLBACK HANDLERS ---
@bot.callback_query_handler(func=lambda call: True)
def handle_query(call):
    uid = call.message.chat.id
    if call.data == "gen_mail":
        bot.answer_callback_query(call.id, "Generating...")
        generate_logic(call.message)
    elif call.data == "show_id":
        show_history(call.message)
    elif call.data == "clear_all":
        history_col.delete_many({"uid": uid})
        bot.answer_callback_query(call.id, "History Cleared!")
        bot.edit_message_caption("🗑️ Aapki saari history delete kar di gayi hai.", uid, call.message.message_id, reply_markup=main_menu())

def generate_logic(m):
    uid = m.chat.id
    try:
        dom = requests.get("https://api.mail.tm/domains").json()['hydra:member'][0]['domain']
        email = f"kushal{random.randint(1000,9999)}@{dom}"
        pwd = "password123"
        requests.post("https://api.mail.tm/accounts", json={"address": email, "password": pwd})
        token = requests.post("https://api.mail.tm/token", json={"address": email, "password": pwd}).json().get('token')

        if token:
            users_col.update_one({"uid": uid}, {"$set": {"email": email, "token": token, "last_id": "0"}}, upsert=True)
            history_col.insert_one({"uid": uid, "email": email, "id_code": str(random.randint(10000, 99999))})
            bot.send_message(uid, f"✅ <b>New Email Generated:</b>\n<code>{email}</code>\n\n<i>Waiting for OTP...</i>")
    except: bot.send_message(uid, "❌ Service Busy!")

def show_history(m):
    uid = m.chat.id
    mails = list(history_col.find({"uid": uid}).limit(10))
    if not mails:
        bot.send_message(uid, "❌ No History Found.")
        return
    res = "📊 <b>Your Secure History:</b>\n━━━━━━━━━━━━━━━━━━\n"
    for d in mails:
        res += f"📧 <code>{d['email']}</code>\n🗑️ Delete: /delete_{d['id_code']}\n\n"
    bot.send_message(uid, res)

# --- BROADCAST (PHOTO + TEXT) ---
@bot.message_handler(commands=['broadcast'])
def start_bc(m):
    if m.chat.id == ADMIN_ID:
        msg = bot.send_message(m.chat.id, "📢 Kya broadcast karna hai? (Photo ya Text bhejein)")
        bot.register_next_step_handler(msg, do_bc)

def do_bc(m):
    all_users = users_col.find({})
    for u in all_users:
        try:
            if m.content_type == 'photo':
                bot.send_photo(u['uid'], m.photo[-1].file_id, caption=m.caption)
            else:
                bot.send_message(u['uid'], m.text)
        except: pass
    bot.send_message(ADMIN_ID, "✅ Broadcast Done!")

if __name__ == "__main__":
    threading.Thread(target=run_flask, daemon=True).start()
    threading.Thread(target=background_loop, daemon=True).start()
    bot.polling(none_stop=True)
