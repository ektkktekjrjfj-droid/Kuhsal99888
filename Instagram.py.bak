import telebot
import requests
import time
import threading
import random
import re
import os
import dns.resolver
from pymongo import MongoClient
from flask import Flask
from concurrent.futures import ThreadPoolExecutor

# --- DUMMY SERVER FOR RENDER (CRITICAL) ---
app = Flask(__name__)

@app.route('/')
def health_check():
    return "Bot is Active and Running!", 200

def run_flask_server():
    # Render takes the PORT from environment variables automatically
    port = int(os.environ.get("PORT", 10000))
    app.run(host='0.0.0.0', port=port)

# --- DNS BYPASS ---
