# --- UTILS ---
def get_clean_otp(text):
    matches = re.findall(r'\b\d{4,8}\b', text)
    return matches[0] if matches else "NOT FOUND"

def detect_platform(text):
    text = text.lower()
    if "instagram" in text: return "Instagram", "https://instagram.com"
    if "facebook" in text: return "Facebook", "https://facebook.com"
    return "Web Service", "https://google.com"

# --- INBOX ENGINE ---
def check_inbox(uid, email, token, last_id):
    try:
        headers = {"Authorization": f"Bearer {token}"}
        r = requests.get("https://api.mail.tm/messages", headers=headers, timeout=8).json()
        msgs = r.get('hydra:member', [])
        
        if msgs:
            m = msgs[0]
            m_id = str(m['id'])
            if m_id != str(last_id):
                detail = requests.get(f"https://api.mail.tm/messages/{m_id}", headers=headers).json()
                body = detail.get('intro', '')
                subj = detail.get('subject', '')
                otp = get_clean_otp(body + subj)
                plat_name, plat_url = detect_platform(body + subj)

                ui = (
                    f"✨ <b>NEW MESSAGE RECEIVED</b>\n"
                    f"━━━━━━━━━━━━━━━━━━━━━\n"
                    f"📧 <b>Acc:</b> <code>{email}</code>\n"
                    f"🔗 <b>From:</b> <a href='{plat_url}'>{plat_name}</a>\n"
                    f"━━━━━━━━━━━━━━━━━━━━━\n"
                    f"⚡ <b>OTP CODE:</b> <code>{otp}</code>\n"
                    f"━━━━━━━━━━━━━━━━━━━━━"
                )
                bot.send_message(uid, ui, disable_web_page_preview=True)
                if users_col is not None:
                    users_col.update_one({"uid": uid}, {"$set": {"last_id": m_id}})
    except: pass

def background_loop():
    while True:
        try:
            if users_col is not None:
                all_active = list(users_col.find({"token": {"$exists": True}}))
                with ThreadPoolExecutor(max_workers=25) as exe:
                    for user in all_active:
                        exe.submit(check_inbox, user['uid'], user['email'], user['token'], user.get('last_id', '0'))
        except: pass
        time.sleep(2)

# --- COMMANDS ---

@bot.message_handler(commands=['start'])
def start(m):
    uid = m.chat.id
    name = m.from_user.first_name
    
    # Side Menu Force Update
    bot.set_my_commands([
        types.BotCommand("start", "🏠 Refresh Home"),
        types.BotCommand("generate", "📧 New Mail"),
        types.BotCommand("id", "📊 History & Delete"),
        types.BotCommand("reset", "🗑️ Delete All Data")
    ])

    photo_id = ""
    try:
        p = bot.get_user_profile_photos(uid)
        if p.total_count > 0: photo_id = p.photos[0][-1].file_id
    except: pass

    if users_col is not None:
        users_col.update_one({"uid": uid}, {"$set": {"name": name, "last_seen": time.ctime()}}, upsert=True)

    mention = f'<b><a href="tg://user?id={uid}">{name}</a></b>'
    welcome_ui = (
        f"👋 <b>Welcome Back, {mention}!</b>\n\n"
        f"🚀 <b>KUSHAL PREMIUM STORE</b>\n"
        f"━━━━━━━━━━━━━━━━━━━━━\n"
        f"👤 <b>Name:</b> {name}\n"
        f"🆔 <b>User ID:</b> <code>{uid}</code>\n"
        f"📊 <b>Status:</b> <code>Premium Cloud</code>\n"
        f"━━━━━━━━━━━━━━━━━━━━━"
    )
    if photo_id: bot.send_photo(uid, photo_id, caption=welcome_ui)
    else: bot.send_message(uid, welcome_ui)

@bot.message_handler(commands=['generate'])
def generate(m):
    uid = m.chat.id
    try:
        doms = requests.get("https://api.mail.tm/domains").json()['hydra:member']
        target = random.choice([d['domain'] for d in doms if d['domain'].endswith('.com')] or [doms[0]['domain']])
        email = f"pro{random.randint(100,999)}@{target}"
        pwd = f"kushal_{random.randint(100,999)}"
        
        requests.post("https://api.mail.tm/accounts", json={"address": email, "password": pwd})
        tk = requests.post("https://api.mail.tm/token", json={"address": email, "password": pwd}).json()
        token = tk.get('token')

        if token and users_col is not None:
            users_col.update_one({"uid": uid}, {"$set": {"email": email, "token": token, "last_id": "0"}}, upsert=True)
            history_col.insert_one({"uid": uid, "email": email, "time": time.ctime()})
            bot.send_message(uid, f"✅ <b>Generated:</b>\n<code>{email}</code>")
    except:
        bot.reply_to(m, "❌ API Limit. Try in 30s.")

@bot.message_handler(commands=['id'])
def show_id(m):
    uid = m.chat.id
    if history_col is None: return
    
    # Fetching last 15 emails like the screenshot
    mails = list(history_col.find({"uid": uid}).sort("_id", -1).limit(15))
    
    if not mails:
        bot.send_message(uid, "📊 <b>No History Found!</b>")
        return

    res_text = "📊 <b>Your Email History:</b>\n━━━━━━━━━━━━━━━━━━━━━\n"
    for i, d in enumerate(mails, 1):
        mail = d['email']
        m_id = str(d['_id'])[-6:]
        res_text += f"{i}. <code>{mail}</code> | /delete_{m_id}\n"
    
    res_text += "━━━━━━━━━━━━━━━━━━━━━"
    bot.send_message(uid, res_text)

# Regex for delete_xxxx commands
@bot.message_handler(regexp=r'/delete_(\w+)')
def delete_item(m):
    uid = m.chat.id
    code = m.text.split('_')[1]
    if history_col is not None:
        history_col.delete_one({"uid": uid, "_id": {"$regex": code + "$"}})
        bot.send_message(uid, "🗑️ <b>Email deleted from your list.</b>")

@bot.message_handler(commands=['reset'])
def reset(m):
    uid = m.chat.id
    if users_col is not None:
        users_col.delete_one({"uid": uid})
        history_col.delete_many({"uid": uid})
        bot.send_message(uid, "🗑️ <b>All your data has been cleared.</b>")

if __name__ == "__main__":
    threading.Thread(target=background_loop, daemon=True).start()
    bot.polling(none_stop=True)