# --- MONGODB SETUP ---
users_col = None
history_col = None
try:
    # Adding timeout and forcing standard connection
    client = MongoClient(MONGO_URI, tlsAllowInvalidCertificates=True, serverSelectionTimeoutMS=20000)
    db = client['KushalPremiumStore']
    users_col = db['users']
