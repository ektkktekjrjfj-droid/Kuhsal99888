import os
import asyncio
import logging
import random
from flask import Flask
from threading import Thread
from pyrogram import Client, filters, idle
from pyrogram.types import InlineKeyboardMarkup, InlineKeyboardButton, BotCommand

# --- [ LOGGING ] ---
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("AHMED_X_FINAL")

# --- [ CONFIGURATION ] ---
API_ID = 21552435
API_HASH = "5b108bd2fdd31c0c34bc65f24a5216a0"
# Naya Token check kar lena
BOT_TOKEN = "8464390807:AAGVxObZ60Se34Kjo3nX34I0iDa8VBAcsRY"
OWNER_ID = 6632236983

# --- [ WEB SERVER ] ---
web = Flask('')
@web.route('/')
def home(): return "Ahmed X Engine Online ✅"

def run_web():
    try:
        # Dynamic Port selection
        port = int(os.environ.get("PORT", random.randint(8000, 9000)))
        web.run(host='0.0.0.0', port=port)
    except: pass

# --- [ INITIALIZATION ] ---
# Session name change kiya hai taaki purana lock hat jaye
app = Client("AhmedX_FINAL_FIX", api_id=API_ID, api_hash=API_HASH, bot_token=BOT_TOKEN)

BR = "━━━━━━━━━━━━━━━━━━━━━━━━"

# --- [ DIRECT RESPONSE HANDLER ] ---

@app.on_message(filters.all) # Sab kuch scan karega
async def global_handler(client, message):
    if not message.text: return
    
    uid = message.from_user.id
    cmd = message.text.lower()
    logger.info(f"📩 Received: {cmd} from {uid}")

    # Start Command
    if cmd.startswith("/start"):
        text = (
            f"{BR}\n"
            f"🔥 **AHMED X STOREZ - LIVE**\n"
            f"{BR}\n"
            f"👋 Welcome, {message.from_user.first_name.upper()}\n"
            f"🛡 Rank: {'Owner' if uid == OWNER_ID else 'Member'}\n"
            f"{BR}\n"
            f"Select an option below:\n"
            f"{BR}"
        )
        btns = InlineKeyboardMarkup([[
            InlineKeyboardButton("📦 PRODUCTS", callback_data="p"),
            InlineKeyboardButton("🛡 SUPPORT", url="t.me/Kushal_X")
        ]])
        await message.reply_text(text, reply_markup=btns)

    # Indo Fix Command
    elif cmd.startswith("/indofix"):
        if len(message.command) < 2:
            return await message.reply("❌ **Usage:** `/indofix goat.2445809 000222`")
        
        data = message.text.split(None, 1)[1]
        await message.reply(
            f"{BR}\n"
            f"🛠 **INDO-FIX INITIATED**\n"
            f"{BR}\n"
            f"📥 **DATA:** `{data}`\n"
            f"⏳ **STATUS:** STABILIZING...\n"
            f"{BR}\n"
            f"✅ **DONE! SYSTEM UPDATED.**"
        )

# --- [ CALLBACKS ] ---
@app.on_callback_query()
async def cb(client, query):
    if query.data == "p":
        await query.message.edit(f"{BR}\n🛒 **STOCK**\n{BR}\n1. FB ID CLONE - ₹499\n{BR}\n**DM @Kushal_X**")

# --- [ ENGINE START ] ---

async def main_engine():
    Thread(target=run_web, daemon=True).start()
    try:
        logger.info("🚀 Booting Ahmed X...")
        await app.start()
        await app.set_bot_commands([
            BotCommand("start", "Menu"),
            BotCommand("indofix", "Fix Account")
        ])
        logger.info("✅ SUCCESS: Ahmed X is Online!")
        await idle()
    except Exception as e:
        logger.error(f"❌ ERROR: {e}")
    finally:
        if app.is_connected:
            await app.stop()

if __name__ == "__main__":
    try:
        asyncio.run(main_engine())
    except: pass